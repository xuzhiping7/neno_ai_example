# 网页服务（与上游 API 的端口相互独立）
APP_HOST=0.0.0.0
APP_PORT=7777

# 首次启动后在网页「连接配置」填写，也可在这里填写。
# HOST 包含 http:// 或 https://，不包含 /api/v1。
# 端口可留空，使用地址对应的默认端口（HTTP 80 / HTTPS 443）。
NENO_API_HOST=
NENO_API_PORT=
NENO_API_KEY=
# 可选：文档站根地址，不包含 /api-docs 路径。
NENO_DOCS_URL=

# 可选：仅用于 GET /projects/:id/api-key，需要项目拥有者的用户访问令牌
NENO_OWNER_TOKEN=

# 每次上游请求最长等待；SSE 单独允许持续 30 分钟
API_TIMEOUT_MS=90000
